{{ ansible_managed | comment }}
# Sourced by /etc/restic/restic-*.sh and loaded as EnvironmentFile= by
# the restic-*.service systemd units. Keep mode 0600.

RESTIC_REPOSITORY={{ _restic_env_repository | default(restic_repository) }}
RESTIC_PASSWORD_FILE={{ _restic_env_password_file | default(restic_password_file) }}
{% for key, value in (restic_env | dictsort) %}
{{ key }}={{ value }}
{% endfor %}
